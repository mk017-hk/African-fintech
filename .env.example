# ============================================================================
# AfriStable Pay — environment template
# Copy to .env and fill in. NEVER commit real values.
# All secrets must be injected from a vault in production.
# ============================================================================

# ---- App ----
NODE_ENV=development
APP_NAME=AfriStable Pay
LOG_LEVEL=info

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://afristable:afristable@localhost:5432/afristable?schema=public

# ---- Redis (cache, locks, BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / Crypto ----
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-me-with-strong-random-secret
JWT_REFRESH_SECRET=replace-me-with-different-strong-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# AES-256-GCM key for column-level encryption of PII (32 bytes hex)
PII_ENCRYPTION_KEY=replace-me-32-byte-hex-key
# Key used to HMAC quote payloads
QUOTE_SIGNING_KEY=replace-me-with-strong-random-secret
# Webhook signing secret
WEBHOOK_SIGNING_SECRET=replace-me-with-strong-random-secret

# ---- Passkey / WebAuthn ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AfriStable Pay
WEBAUTHN_ORIGIN=http://localhost:3000

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Rate limiting ----
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10

# ---- Risk thresholds ----
WITHDRAWAL_AUTO_APPROVE_USD=1000
WITHDRAWAL_MANUAL_REVIEW_USD=5000
QUOTE_TTL_SECONDS=45

# ---- Provider placeholders (sandbox) ----
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=

ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- Blockchain RPC (use your own private RPC in production) ----
EVM_ETHEREUM_RPC_URL=
EVM_POLYGON_RPC_URL=
EVM_BASE_RPC_URL=
SOLANA_RPC_URL=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# USDC contract addresses (canonical mainnet by default; override per env)
USDC_ETHEREUM=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDC_POLYGON=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDT_ETHEREUM=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_POLYGON=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# ---- Price feed ----
PRICE_FEED_PROVIDER=coingecko
PRICE_FEED_API_KEY=

# ---- Sanctions / KYC providers (placeholders) ----
SANCTIONS_PROVIDER_URL=
SANCTIONS_PROVIDER_API_KEY=
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=
