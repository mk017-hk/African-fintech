{
  "name": "afristable-pay",
  "version": "0.1.0",
  "private": true,
  "description": "AfriStable Pay — stablecoin-powered global money platform for Africa",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @afristable/database prisma:generate",
    "db:migrate": "pnpm --filter @afristable/database prisma:migrate",
    "db:seed": "pnpm --filter @afristable/database seed",
    "db:seed:dev": "pnpm --filter @afristable/database seed:dev",
    "db:reset": "pnpm --filter @afristable/database prisma:reset",
    "api:dev": "pnpm --filter @afristable/api dev",
    "web:dev": "pnpm --filter @afristable/web dev",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}
